// Structs are plain C structs: same layout, same ABI, no surprises.
use std::math;

struct Point {
    x: f64,
    y: f64,
}

fn distance(a: Point, b: Point) -> f64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    return sqrt(dx * dx + dy * dy);
}

fn main() {
    let origin = Point { x: 0.0, y: 0.0 };
    let p = Point { x: 3.0, y: 4.0 };
    println!("distance from origin to ({}, {}) = {:.2}", p.x, p.y, distance(origin, p));

    let fast: bool = true;
    println!("is C7 blazingly fast? {}", fast);
}
